# StreamSphere Environment Configuration
NODE_ENV=development
PORT=5000

# Database & Cache
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/streamsphere?schema=public"
REDIS_URL="redis://localhost:6379"

# Security & Tokens
JWT_ACCESS_SECRET="streamsphere_super_secret_access_jwt_key_2026_production_grade"
JWT_REFRESH_SECRET="streamsphere_super_secret_refresh_jwt_key_2026_production_grade"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Sandbox Webhook Secret
PAYMENT_WEBHOOK_SECRET="whsec_sandbox_streamsphere_secure_hash_secret_2026"

# Media Delivery & CDN
CDN_BASE_URL="https://cdn.streamsphere.net"
MEDIA_STREAM_SIGNING_SECRET="media_signature_secret_ott_2026"

# Client Web URL for CORS
CORS_ORIGIN="http://localhost:3000"
